{
  "name": "healthmaxxing",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "worker": "bun run src/bull/worker.ts",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:import": "bun run scripts/import-sqlite.ts",
    "db:verify": "bun run scripts/verify-migration.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.4",
    "@fastify/websocket": "^11.2.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@langchain/core": "^1.2.1",
    "@langchain/deepseek": "^1.1.3",
    "@langchain/google": "^0.2.1",
    "@langchain/openai": "^1.5.3",
    "@langchain/openrouter": "^0.4.3",
    "bullmq": "^5.79.2",
    "fastify": "^5.9.0",
    "langchain": "^1.5.2",
    "uuid": "^14.0.1"
  }
}
