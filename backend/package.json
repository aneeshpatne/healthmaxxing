{
  "name": "healthmaxxing",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:import": "bun run scripts/import-sqlite.ts",
    "db:verify": "bun run scripts/verify-migration.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@langchain/core": "^1.1.46",
    "@langchain/deepseek": "^1.0.27",
    "@langchain/google": "^0.1.11",
    "@langchain/openai": "^1.4.5",
    "@langchain/openrouter": "^0.2.4",
    "bullmq": "^5.78.0",
    "fastify": "^5.8.5",
    "langchain": "^1.4.0",
    "uuid": "^14.0.0"
  }
}
